<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="eink_settings.xml" />
        <include domain="sharedpref" path="eink_launcher_prefs.xml" />
        <include domain="sharedpref" path="eink_tutorial_prefs.xml" />
        <include domain="file" path="reading_stats.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pdf_cache/" />
        <exclude domain="file" path="sync_tmp/" />
    </device-transfer>
</data-extraction-rules>
