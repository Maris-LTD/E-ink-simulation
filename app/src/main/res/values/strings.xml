    <!-- Tutorial -->
    <string name="tutorial_header">User Guide</string>
    <string name="tutorial_skip">Skip</string>
    <string name="tutorial_prev">‹ Prev</string>
    <string name="tutorial_next">Next ›</string>
    <string name="tutorial_start">Start Reading</string>
    <string name="tutorial_s1_tag">STEP 1 / 4 · LIBRARY</string>
    <string name="tutorial_s1_title">Import Books from Device &amp; Drive</string>
    <string name="tutorial_s1_b1_t">Quick Import</string>
    <string name="tutorial_s1_b1_d">Tap the (+) button at the bottom right to import EPUB, PDF, or CBZ files from your device.</string>
    <string name="tutorial_s1_b2_t">Open from Google Drive</string>
    <string name="tutorial_s1_b2_d">In the file picker, open the top-left menu ≡ → select Drive to download books for offline reading.</string>
    <string name="tutorial_s1_b3_t">Filter &amp; Layout</string>
    <string name="tutorial_s1_b3_d">Switch between List or 2–4 Column Grid views, filter by author, or browse Bookmarks &amp; Highlights.</string>
    <string name="tutorial_s2_tag">STEP 2 / 4 · READING</string>
    <string name="tutorial_s2_title">Reading Gestures &amp; Focus Mode</string>
    <string name="tutorial_s2_b1_t">Page Turns &amp; Controls</string>
    <string name="tutorial_s2_b1_d">Tap left/right edges (or volume keys) to turn pages; tap the center to toggle toolbars.</string>
    <string name="tutorial_s2_b2_t">Brightness &amp; Lookup</string>
    <string name="tutorial_s2_b2_d">Swipe vertically along the left edge to adjust brightness; long-press text to Highlight, Note, or Translate.</string>
    <string name="tutorial_s2_b3_t">Focus Mode</string>
    <string name="tutorial_s2_b3_d">Tap Focus on the bottom bar to hide system bars, keep screen on, and enable Do Not Disturb.</string>
    <string name="tutorial_s3_tag">STEP 3 / 4 · E-INK SYSTEM</string>
    <string name="tutorial_s3_title">Launcher, Lock Screen &amp; Wallpaper</string>
    <string name="tutorial_s3_b1_t">E-Ink Launcher</string>
    <string name="tutorial_s3_b1_d">Set the app as your default Home Launcher for a minimalist monochrome home; swipe right for the App Drawer.</string>
    <string name="tutorial_s3_b2_t">Pinning &amp; View Modes</string>
    <string name="tutorial_s3_b2_d">In the App Drawer, switch between List / 3–4 Grid / Text Only and long-press apps to pin to Home.</string>
    <string name="tutorial_s3_b3_t">Lock Screen &amp; Wallpaper</string>
    <string name="tutorial_s3_b3_d">Enable Lock Screen Reading in Reader Settings, or set the E-Ink Live Wallpaper in Stats &amp; Profile.</string>
    <string name="tutorial_s4_tag">STEP 4 / 4 · SYNC</string>
    <string name="tutorial_s4_title">Google Sign-In &amp; Multi-Device Sync</string>
    <string name="tutorial_s4_b1_t">Open Stats &amp; Profile</string>
    <string name="tutorial_s4_b1_d">Tap the Profile icon at the top right (or swipe right from the Library).</string>
    <string name="tutorial_s4_b2_t">Google Sign-In (Free)</string>
    <string name="tutorial_s4_b2_d">Tap Sign in with Google to back up reading progress, bookmarks, highlights, and streaks to Drive AppData.</string>
    <string name="tutorial_s4_b3_t">Full Library Sync</string>
    <string name="tutorial_s4_b3_d">Enable Sync book files so signing in on another device automatically restores your books and last page.</string>

