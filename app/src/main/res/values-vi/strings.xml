    <string name="tutorial_start">Bắt đầu đọc</string>
    <string name="tutorial_s1_tag">BƯỚC 1 / 4 · THƯ VIỆN</string>
    <string name="tutorial_s1_title">Nhập sách từ máy &amp; Google Drive</string>
    <string name="tutorial_s1_b1_t">Thêm sách nhanh</string>
    <string name="tutorial_s1_b1_d">Chạm nút (+) ở góc dưới phải để nhập tệp EPUB, PDF hoặc CBZ từ bộ nhớ máy.</string>
    <string name="tutorial_s1_b2_t">Mở từ Google Drive</string>
    <string name="tutorial_s1_b2_d">Trong trình chọn tệp, bấm menu ≡ (góc trên trái) → chọn Drive để tải sách trực tiếp về đọc offline.</string>
    <string name="tutorial_s1_b3_t">Lọc &amp; Sắp xếp</string>
    <string name="tutorial_s1_b3_d">Đổi kiểu xem Danh sách / Lưới 2-3-4 cột, lọc theo tác giả hoặc tìm trong Dấu trang &amp; Highlights.</string>
    <string name="tutorial_s2_tag">BƯỚC 2 / 4 · ĐỌC SÁCH</string>
    <string name="tutorial_s2_title">Cử chỉ đọc &amp; Focus Mode</string>
    <string name="tutorial_s2_b1_t">Lật trang &amp; Công cụ</string>
    <string name="tutorial_s2_b1_d">Chạm mép trái/phải (hoặc phím âm lượng) để lật trang; chạm giữa màn hình để mở thanh công cụ.</string>
    <string name="tutorial_s2_b2_t">Độ sáng &amp; Ghi chú</string>
    <string name="tutorial_s2_b2_d">Vuốt dọc mép trái để chỉnh nhanh độ sáng; nhấn giữ chọn chữ để Highlight, Ghi chú hoặc Tra từ điển.</string>
    <string name="tutorial_s2_b3_t">Focus Mode</string>
    <string name="tutorial_s2_b3_d">Bật nút Focus trên thanh công cụ để ẩn mọi thanh hệ thống, giữ sáng màn hình và tự bật Không làm phiền (DND).</string>
    <string name="tutorial_s3_tag">BƯỚC 3 / 4 · HỆ THỐNG E-INK</string>
    <string name="tutorial_s3_title">Launcher, Màn hình khóa &amp; Hình nền</string>
    <string name="tutorial_s3_b1_t">E-Ink Launcher</string>
    <string name="tutorial_s3_b1_d">Đặt app làm Màn hình chính mặc định để dùng giao diện tối giản đen trắng; vuốt sang phải mở Ngăn ứng dụng.</string>
    <string name="tutorial_s3_b2_t">Ghim &amp; Chế độ xem</string>
    <string name="tutorial_s3_b2_d">Ở Ngăn ứng dụng, đổi giữa Danh sách / Lưới 3-4 / Chỉ chữ và nhấn giữ app để ghim ra Home.</string>
    <string name="tutorial_s3_b3_t">Màn hình khóa &amp; Wallpaper</string>
    <string name="tutorial_s3_b3_d">Bật \"Đọc trên màn hình khóa\" trong Cài đặt đọc, hoặc đặt Hình nền động E-Ink trong Hồ sơ &amp; Thống kê.</string>
    <string name="tutorial_s4_tag">BƯỚC 4 / 4 · ĐỒNG BỘ</string>
    <string name="tutorial_s4_title">Đăng nhập Google &amp; Đồng bộ đa máy</string>
    <string name="tutorial_s4_b1_t">Mở Hồ sơ &amp; Thống kê</string>
    <string name="tutorial_s4_b1_d">Chạm biểu tượng Hồ sơ ở góc trên phải (hoặc vuốt sang phải từ Thư viện).</string>
    <string name="tutorial_s4_b2_t">Đăng nhập Google (0đ)</string>
    <string name="tutorial_s4_b2_d">Bấm \"Đăng nhập với Google\" để tự động lưu tiến độ đọc, dấu trang, highlight và chuỗi ngày đọc lên Drive AppData.</string>
    <string name="tutorial_s4_b3_t">Đồng bộ cả tủ sách</string>
    <string name="tutorial_s4_b3_d">Bật \"Đồng bộ cả file sách\" để sang máy khác chỉ cần đăng nhập là tự tải lại toàn bộ sách và trang đang đọc.</string>

